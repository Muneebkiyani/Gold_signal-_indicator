# ══════════════════════════════════════════════════════════════
# XAUUSD Gold Signal System — Environment Configuration
# ══════════════════════════════════════════════════════════════
# Copy this file:   cp .env.example .env
# Then fill in your real values in .env
#
# SECURITY RULES:
#   - NEVER commit .env to version control
#   - NEVER share DATA_PROVIDER_API_KEY or TELEGRAM_BOT_TOKEN
#   - .env is listed in .gitignore — keep it that way
# ══════════════════════════════════════════════════════════════


# ── Application ───────────────────────────────────────────────
APP_NAME="XAUUSD Gold Signal System"
APP_VERSION="1.0.0"
DEBUG=false
LOG_LEVEL=INFO

# ── Server ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/signals.db

# ── Market Data Provider ──────────────────────────────────────
# ⚠ KEEP SECRET — never commit a real key
DATA_PROVIDER_API_KEY=your_api_key_here
DATA_PROVIDER_BASE_URL=https://api.example-provider.com/v1

# ── Telegram Alerts ───────────────────────────────────────────
# ⚠ KEEP SECRET — never commit real tokens
# These values are NEVER forwarded to the frontend
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_ENABLED=false

# Suppress informational "no entry" messages (true = silent unless signal fires)
NO_ENTRY_TELEGRAM_ALERTS=false

# ── Instrument ────────────────────────────────────────────────
SYMBOL=XAUUSD
# Allowed timeframes: M1 | M5 | M15 | M30 | H1 | H4 | D1
TIMEFRAME=M15

# ── EMA — Exponential Moving Averages ─────────────────────────
# EMA_FAST must be strictly less than EMA_SLOW
EMA_FAST=9
EMA_SLOW=21

# ── RSI — Relative Strength Index ─────────────────────────────
RSI_LENGTH=14
RSI_MID=50
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30

# ── ADX — Average Directional Index ───────────────────────────
ADX_LENGTH=14
ADX_SMOOTHING=14
# Minimum ADX to confirm trend strength before entering a trade
ADX_MIN=20

# ── SMA — Simple Moving Average (trend bias filter) ───────────
SMA_LENGTH=81

# ── ATR — Average True Range (SL/TP sizing) ───────────────────
ATR_LENGTH=14

# ── Signal Behaviour ──────────────────────────────────────────
# true  = signals generated only on confirmed bar close
# false = signals generated mid-bar (may repaint)
SIGNAL_ON_CLOSE=true
